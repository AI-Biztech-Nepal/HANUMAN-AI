# === Required ===
ANTHROPIC_API_KEY=sk-ant-...             # console.anthropic.com
CLAUDE_MODEL=claude-haiku-4-5-20251001   # Haiku = low cost/call; upgrade per-tenant if needed
ADMIN_API_KEY=change-me-to-a-long-random-string   # protects /admin endpoints

# === Company / agent identity ===
COMPANY_NAME=Your Company Pvt. Ltd.
AGENT_NAME=Asha
DEFAULT_LANGUAGE=auto               # auto | ne | en  (auto = match the caller)

# === Telephony (fill in whichever provider you use) ===
# Twilio path:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public URL of this server (Twilio must reach it). e.g. https://calls.yourdomain.com.np
PUBLIC_BASE_URL=

# === Speech ===
WHISPER_MODEL=small                 # tiny|base|small|medium — small is fine on 4GB VPS
TTS_VOICE=en_US-amy-medium          # piper voice; see README for Nepali options

# === Storage ===
LEADS_DB_PATH=./leads.db

# === Asterisk ARI bridge (media/asterisk_bridge.py) — Phase 1, groundwork ===
# Only needed once you have Asterisk running on this same VPS. See docs/ASTERISK_SETUP.md.
ARI_BASE_URL=http://127.0.0.1:8088/ari
ARI_USERNAME=
ARI_PASSWORD=
ARI_APP_NAME=hanuman
EXTERNAL_MEDIA_HOST=127.0.0.1
ASTERISK_SOUNDS_DIR=/var/lib/asterisk/sounds/custom

# Brain: "claude" (needs ANTHROPIC_API_KEY) or "ollama" (local, no key at all).
# Local models are slow on CPU and weaker at Nepali - see tools/ before switching a live tenant.
LLM_BACKEND=claude
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
